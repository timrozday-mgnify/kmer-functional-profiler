params {
    run          = ''         // a finished fmh-benchmark outdir: units/, truth/, mgnify/
    annotation   = 'sparse'   // its first MGnify entry's name: mgnify/<annotation>_gene_units.parquet
    gene_units   = ''         // or that file's path
    members      = ''         // the MGnify entries' members (parquet files or directories)
    genomes      = ''         // the benchmark's genomes (<data_dir>/genomes_extracted_from_kegg)
    chunks       = 16         // DIAMOND jobs over the genome proteins
    // a gene in a large cluster can fill its targets with that cluster's members and lose
    // another cluster's (gene_units.parquet: member_hit false)
    nearest_diamond_args = '--sensitive --max-target-seqs 1000 --id 50 --query-cover 50'
    // the nearest member counts only hits at this query and subject coverage, as aai-model's
    // pairs; on the command line, so changing it reruns NEAREST under -resume (DIAMOND stays)
    nearest_min_cov = 0.8
    // aai_model.json files to re-estimate aai under, besides the profiles' own: [name:, path:]
    models       = ['step34', 'step34_nounion', 'step34_ends1'].collect { m ->
        [name: m, path: "${projectDir}/../fmh-benchmark/ablations/aai_models/${m}.json"]
    }
    outdir       = 'results'
    venv         = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    bench        = "${params.venv}/bin/python ${projectDir}/../fmh-benchmark/bench.py"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'process_single' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
}

profiles {
    slurm { process.executor = 'slurm' }
    docker {
        docker.enabled    = true
        docker.runOptions = '--platform linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/singularity"
    }
    test {  // stub runs
        process {
            withLabel: 'process_single|process_medium' { cpus = 1; memory = 1.GB; time = 10.m }
        }
    }
}
