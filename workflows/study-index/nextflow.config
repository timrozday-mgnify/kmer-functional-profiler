params {
    name         = 'study'      // the study index's directory name under outdir/study
    contigs      = ''           // nucleotide FASTA (glob): contigs or MAGs, one file per MAG
    proteins     = ''           // protein FASTA (glob) instead: gene calling skipped
    base         = ''           // index the study is queried with; its build parameters are copied
    // MGnify90's rule; check against the release notes of the base's MGnify release
    cluster_args = '--min-seq-id 0.9 -c 0.8 --cov-mode 1'
    pfam_url     = 'https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release'  // set to the base's Pfam release
    pfam_hmm     = ''           // a local Pfam-A.hmm instead of downloading it
    pfam_chunks  = 8            // hmmsearch jobs
    role         = ''           // 'decoy': host or contaminant proteomes (see README)
    db_dir       = 'study-index-db'
    outdir       = 'results'
    venv         = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    python       = "${params.venv}/bin/python"
    kfp          = "${params.venv}/bin/kmer-functional-profiler"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'process_single' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: 'process_index' {  // the Python build holds the members' k-mers in memory
        cpus   = 1
        memory = { 64.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
}

// pyrodigal, MMseqs2 and hmmsearch run in containers (-profile docker or singularity); the
// rest runs on the host, in the project's venv.

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"   // per-task time and memory: the gate's build cost
    fields    = 'task_id,name,status,exit,cpus,realtime,%cpu,peak_rss'
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '--platform linux/amd64'  // biocontainers are amd64 only
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/singularity"
    }
    test {
        // the fmh fixture genomes as a study; the base is built first (README, Test)
        params.contigs     = "${projectDir}/../../tests/data/mini_fmh/genomes_extracted_from_kegg/*/*.fasta"
        params.base        = 'results-test/base'
        params.pfam_hmm    = "${projectDir}/../../tests/data/mini_fmh/Pfam-mini.hmm"
        params.pfam_chunks = 2
        params.outdir      = 'results-test'
        trace.file         = 'results-test/trace.tsv'
        process {
            withLabel: 'process_single' { memory = 1.GB; time = 10.m }
            withLabel: 'process_medium' { cpus = 2; memory = 2.GB; time = 10.m }
            withLabel: 'process_index' { memory = 2.GB; time = 10.m }
        }
    }
}
