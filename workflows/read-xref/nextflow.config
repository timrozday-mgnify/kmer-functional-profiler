// The pileup pipeline's params, processes and profiles (docker, singularity, slurm; its
// test profiles are overridden below), then this pipeline's own.
includeConfig '../pileup/nextflow.config'

params {
    genomes      = ''      // TSV: genome, path (nucleotide FASTA, gzipped or not; relative to
                           // the TSV allowed; unique file names), optional taxonomy (GTDB-style)
    sylph        = true    // pick genomes by sylph profile; false maps to every genome
    sylph_db     = ''      // a prebuilt .syldb of the same genomes (skips SKETCH)
    sketch_args  = ''
    sylph_args   = ''
    bowtie2_k    = 10      // alignments per pair, split evenly among the best-scoring genomes
    bowtie2_args = ''
    min_identity = 0.95    // 1 - NM / aligned length, per mate
    min_mapq     = 0       // with -k, MAPQ marks multi-mapping, which the split handles
    outdir       = 'results'
}

process {
    withLabel: 'process_low' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
}

trace.file = "${params.outdir}/trace.tsv"

profiles {
    test {  // the fixture reads against the fixture proteins, and two genomes of their CDS
        params.genomes      = "${projectDir}/test/genomes.tsv"
        params.outdir       = 'results-test'
        trace.file          = 'results-test/trace.tsv'
        // sylph detects nothing in 40 read pairs (its empty profile gives an empty table):
        // map to every genome
        params.sylph        = false
        process {
            withLabel: 'process_low' { cpus = 1; memory = 2.GB; time = 20.m }
        }
    }
}
