params {
    release        = 'https://ftp.ebi.ac.uk/pub/databases/metagenomics/peptide_database/current_release'
    biome          = 'root:Host-associated:Human:Digestive system'
    sample         = '1000'           // keep clusters with cluster_rep % sample == 0; a list
                                      // ('100,1000,10000') builds nested subsets
    shards         = 64               // protein_id ranges extracted in parallel
    buckets        = 1                // members split by cluster into this many tables
    max_protein_id = 11200000000L     // above the largest MGYP id in 2026_07
    outdir         = 'results'
    publish_mode   = 'copy'           // for members tables; 'link' at full scale
    pfam           = true             // extract Pfam hits (needed by --index)
    index          = true             // build an index per sample
    index_args     = ''               // extra `kmer-functional-profiler index` options
    build          = false            // partitioned index build over the buckets (one sample)
    ranges         = 64               // hash ranges of the partitioned build's n_groups reduce
    bloom_bits     = 10               // Bloom filter bits per candidate hash (~1% false hits)
    stats          = false            // per-cluster statistics and predicted index size
    stats_args     = ''               // k-mer options for STATS and COMBINE, e.g. '--k 11'
    stats_rate     = 0.001            // rate of sampled (hash, cluster) pairs, for promiscuity
    cost_samples   = '1,10,100,1000,10000'  // predict the 1-in-N subsets of the statistics
    cost_args      = '--n-min 4 8 16 --t-cap 0.05 0.2 --t-dense 0 0.02 0.1'
    query          = false            // query cost study: read ladder x --query_indexes
    query_indexes  = ''               // index directories (glob), each named by its parent,
                                      // e.g. 'cost-nested/1in*/index'
    query_run      = 'ERR7746321'     // ENA paired run to download (Hadza gut, ~106 M pairs)
    query_reads    = ''               // 'R1,R2' local files instead of downloading query_run
    query_ladder   = '10000,100000,400000,1200000,4000000,12000000,40000000'  // nested subsets, in pairs
    query_seed     = 1
    query_draws    = 100              // posterior draws, on the query_draws_on column only
    query_draws_on = '1in100'
    query_memory   = '128 GB'         // cells that exceed it fail and are kept as results
    venv           = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    python         = "${params.venv}/bin/python"
    kfp            = "${params.venv}/bin/kmer-functional-profiler"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'process_medium' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_high_memory' {
        cpus   = 8
        memory = { 128.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withName: 'FETCH_READS' {
        memory = 2.GB
        time   = 12.h
    }
    withName: 'LADDER' {
        cpus   = 4   // gzip processes, one per subset and mate
        memory = 8.GB
        time   = 12.h
    }
    withName: 'QUERY' {
        cpus          = 8
        memory        = { params.query_memory as MemoryUnit }
        time          = 24.h
        errorStrategy = 'ignore'  // out of memory or time: FAILED in trace.tsv
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"   // INDEX rows: build time and peak memory per sample
    raw       = true   // ms and bytes
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    test {
        params.release        = "${projectDir}/../../tests/data/mini_release"
        params.sample         = '1,2'
        params.shards         = 3
        params.max_protein_id = 999
        params.outdir         = 'results-test'
        params.index_args     = '--k 6 --t-base 0.1 --n-min 4'
        params.stats          = true
        params.stats_args     = '--k 6'
        params.stats_rate     = 0.5
        params.cost_samples   = '1,2'
        params.cost_args      = '--t-base 0.1 --n-min 4'
        trace.file            = 'results-test/trace.tsv'
        process {
            withLabel: 'process_medium' { cpus = 1; memory = 1.GB; time = 10.m }
            withLabel: 'process_high_memory' { cpus = 1; memory = 1.GB; time = 10.m }
        }
    }
    test_query {
        // after test: the query cost grid over its indexes, with the fixture reads
        params.index         = false
        params.stats         = false
        params.query         = true
        params.query_indexes = 'results-test/1in*/index'
        params.query_reads   = "${projectDir}/../../tests/data/reads_1.fastq.gz,${projectDir}/../../tests/data/reads_2.fastq.gz"
        params.query_ladder  = '10,40'
        params.query_draws   = 3
        params.query_draws_on = '1in1'
        params.query_memory  = '1 GB'
        params.outdir        = 'results-test-query'
        trace.file           = 'results-test-query/trace.tsv'
        process {
            withName: 'LADDER|QUERY' { cpus = 1 }
        }
    }
    test_build {
        // with test: the partitioned build over two buckets
        params.sample  = '1'
        params.buckets = 2
        params.index   = false
        params.stats   = false
        params.build   = true
        params.ranges  = 3
        params.outdir  = 'results-test-build'
        trace.file     = 'results-test-build/trace.tsv'
    }
}
