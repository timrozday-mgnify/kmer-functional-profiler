params {
    index         = ''       // a kfp index directory (absolute path: read in place), or:
    targets       = ''       // a FASTA to index (`index --targets`; the test profile)
    index_args    = ''
    store         = ''       // members tables to fetch from (absolute glob; default the index's targets.parquet)
    background    = ''       // r1,r2: the real reads the spikes go into, also the unspiked sample
    seeds         = 10       // spiked samples, each with its own units
    units         = 2000     // units spiked per sample
    members       = 3        // sequences fetched per unit (a strain is mutated from one of them)
    // strains at 100/98/95/90% to the member; lognormal depth around 1x, ~0.05-20x
    simulate_args = '--identities 1.0 0.98 0.95 0.9 --depth-mu 0 --depth-sigma 1.5 --max-depth 20'
    shares        = '0.01,0.03,0.1,0.3,inf'  // query --background-share arms
    query_args    = ''
    aai           = false    // query --aai: profiles list every hit unit (SCORE's hit-level recall)
    gather        = 'greedy' // query --gather: greedy or containment
    q             = 0.05     // the rule: at present_q <= q, in every seed,
    max_false     = 0.05     //   false_share <= max_false
    max_null      = 0.01     //   and null_called <= max_null x unspiked_called
    outdir        = 'results'
    venv          = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    kfp           = "${params.venv}/bin/kmer-functional-profiler"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    time          = 4.h
    memory        = 4.GB
    // PICK (unit table and the store) and QUERY at the full standard tier
    withLabel: 'process_medium' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    raw       = true
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem'
}

profiles {
    slurm { process.executor = 'slurm' }
    test {  // the fixture proteins indexed, their reads as the background; 2 seeds of 10 units
        params.targets    = "${projectDir}/../../tests/data/proteins.faa"
        params.index_args = '--k 7 --t-base 1'
        params.background = "${projectDir}/../../tests/data/reads_1.fastq.gz,${projectDir}/../../tests/data/reads_2.fastq.gz"
        params.seeds      = 2
        params.units      = 10
        params.shares     = '0.1,inf'
        params.outdir     = 'results-test'
        trace.file        = 'results-test/trace.tsv'
        process {
            withLabel: 'process_medium' { cpus = 2; memory = 2.GB; time = 20.m }
            withLabel: 'process_low' { cpus = 1; memory = 2.GB; time = 20.m }
        }
    }
}
