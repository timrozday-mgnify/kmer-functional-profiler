// The Pfam-anchored route on one reference (main.nf). Data stays in --data; publishDir
// copies the reports to --outdir.
process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'process_low'    { cpus = 2;  memory = { 16.GB * task.attempt };  time = { 4.h * task.attempt } }
    withLabel: 'process_medium' { cpus = 8;  memory = { 64.GB * task.attempt };  time = { 24.h * task.attempt } }
    withLabel: 'process_high'   { cpus = 16; memory = { 128.GB * task.attempt }; time = { 48.h * task.attempt } }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    raw       = true
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem'
}

profiles {
    slurm { process.executor = 'slurm' }
    singularity { params.runtime = 'singularity' }  // the scripts call singularity themselves
    docker { params.runtime = 'docker' }
    test {  // pfam-reannotate's fixture, no recruitment (kfpfam's models lack its accessions)
        params.release  = "${projectDir}/../../tests/data/mini_reannotate"
        params.pfam     = "${projectDir}/../../tests/data/mini_fmh/Pfam-mini.hmm"
        params.members  = 'results-test/fixture/members.parquet'
        params.families = 'results-test/fixture/families.tsv'
        params.recruit  = false
        params.strains  = 20
        params.per_bin  = 5
        params.pool     = 200
        params.runtime  = 'docker'
        params.outdir   = 'results-test'
        trace.file      = 'results-test/trace.tsv'
        process {
            withLabel: 'process_low'    { cpus = 2; memory = 2.GB; time = 30.m }
            withLabel: 'process_medium' { cpus = 2; memory = 4.GB; time = 30.m }
            withLabel: 'process_high'   { cpus = 2; memory = 4.GB; time = 1.h }
        }
    }
    laptop {  // one job at a time (docs: laptop resource limits)
        executor.queueSize = 1
    }
}
