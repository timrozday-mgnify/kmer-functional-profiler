params {
    store        = ''       // members buckets of the whole release (absolute glob), e.g.
                            // release-tiers/results-standard/members.bucket*.parquet; '' = fixture
    sample       = 5000     // clusters with cluster_rep % sample == 0 (~330 k of 1.66 G)
    stream       = true     // whole-release counts and the cross-cluster representatives
    ranges       = 16       // hash ranges of the streaming reduce
    reduce_passes = 64      // REDUCE sums each range in this many sub-partitions, in turn
    max_extra    = 1000000  // representatives kept for measure-all, those sharing most first
    tree_args    = ''       // shared k-mer options, e.g. '--k 11 --t-base 0.02 --n-min 16'
    stream_args  = ''       // e.g. '--min-shared 4 --sig-every 1 --slice 0.0009765625'
    measure_args = ''       // e.g. '--dense-seqs 50000 --sensitive-seqs 50000'
    // today's standard tier (plan, decided 2026-10-06) on the same proteins
    index_args   = '--k 11 --t-base 0.02 --n-min 16 --oversample 1 --max-groups 16'
    survey       = true     // the floor survey (survey.py) on core and all
    survey_args  = ''       // e.g. '--leaves collapsed,proteins --taus 0,0.3 --n-1s 0,1,2,4'
    // today's index at the survey's other rates (';'-separated), beside the standard tier
    // (slim's rates without its singleton rate; the large tier, tbase05_all)
    tier1_variants = '--k 11 --t-base 0.01 --n-min 8 --oversample 1 --max-groups 16; --k 11 --t-base 0.05 --n-min 32 --oversample 1 --max-groups 16'
    release_index = ''      // the release's standard-tier index directory, for its file sizes
    outdir       = 'results'
    venv         = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    kfp          = "${params.venv}/bin/kmer-functional-profiler"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    time          = 4.h
    memory        = 4.GB
    withLabel: 'process_low' {  // one ~4 GB members bucket in 500 k-sequence batches
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_high_memory' {  // the sample's exact all-pairs join and trees
        cpus   = 16
        memory = { 256.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    raw       = true
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem'
}

profiles {
    slurm { process.executor = 'slurm' }
    test {  // synthetic families in two buckets, every cluster in the sample
        params.sample       = 1
        params.tree_args    = ''
        params.measure_args = '--dense-seqs 400 --sensitive-seqs 400 --chunk-sizes 50,200,1000'
        params.outdir       = 'results-test'
        trace.file          = 'results-test/trace.tsv'
        process {
            withLabel: 'process_low' { cpus = 2; memory = 2.GB; time = 20.m }
            withLabel: 'process_medium' { cpus = 2; memory = 2.GB; time = 20.m }
            withLabel: 'process_high_memory' { cpus = 2; memory = 4.GB; time = 1.h }
        }
    }
    laptop {  // a local members table (--store): one job at a time, two threads
        executor.queueSize = 1
        env.RAYON_NUM_THREADS = '2'
        env.POLARS_MAX_THREADS = '2'
        process {
            withLabel: 'process_low' { cpus = 2; memory = 6.GB }
            withLabel: 'process_medium' { cpus = 2; memory = 6.GB }
            withLabel: 'process_high_memory' { cpus = 2; memory = 8.GB }
        }
    }
}
