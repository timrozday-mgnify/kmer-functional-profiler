params {
    index              = ''          // the index profiles are made with (required)
    gtdb_url           = 'https://data.gtdb.ecogenomic.org/releases/release226/226.0'
    metadata           = ['bac120_metadata_r226.tsv.gz', 'ar53_metadata_r226.tsv.gz']
    ncbi_url           = 'https://ftp.ncbi.nlm.nih.gov/genomes/all'
    data_dir           = 'gtdb-species-index-data'  // the metadata, downloaded once (storeDir)
    // genomes (gtdb.py)
    max_per_species    = 20          // representative first, then by completeness - 5 contamination
    min_completeness   = 50
    max_contamination  = 10
    species            = ''          // file of GTDB species names (s__...) to keep
    max_species        = ''          // or keep this many, sampled (a subset run)
    seed               = 0
    shard_size         = 500         // genomes per download and gene-calling task
    max_downloads      = 4           // concurrent FETCH tasks (NCBI asks for restraint)
    publish_proteins   = false       // also publish faa/<genome>.faa
    species_index_args = ''
    panel              = true        // also the kfp-genomes panel (phase 12) -> <outdir>/panel/
    panel_args         = ''          // e.g. '--max-per-species 50 --neighbours 10'
    outdir             = 'results'
    venv               = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    python             = "${params.venv}/bin/python"
    kfp                = "${params.venv}/bin/kmer-functional-profiler"
    kfp_genomes        = "${params.venv}/bin/kfp-genomes"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'process_single' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 1  // pyrodigal per genome, one at a time
        memory = { 4.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: 'process_high_memory' {
        cpus   = 1
        memory = { 128.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }
}

// pyrodigal runs in a container (-profile docker or singularity); the rest runs on the host,
// in the project's venv.

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    fields    = 'task_id,name,status,exit,cpus,realtime,%cpu,peak_rss'
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '--platform linux/amd64'  // biocontainers are amd64 only
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/singularity"
    }
    test {  // tests/data/mini_gtdb: the mini_uhgg genomes as a GTDB release and NCBI mirror
        params.index        = 'results-test-gtdb/index'
        params.gtdb_url     = "file://${projectDir}/../../tests/data/mini_gtdb"
        params.metadata     = ['bac120_metadata_r0.tsv']
        params.ncbi_url     = "file://${projectDir}/../../tests/data/mini_gtdb/ncbi"
        params.max_per_species = 2
        params.shard_size   = 3
        params.data_dir     = 'results-test-gtdb/data'
        params.outdir       = 'results-test-gtdb'
        trace.file          = 'results-test-gtdb/trace.tsv'
        process {
            withLabel: 'process_single' { memory = 1.GB; time = 10.m }
            withLabel: 'process_medium' { memory = 1.GB; time = 10.m }
            withLabel: 'process_high_memory' { memory = 2.GB; time = 10.m }
        }
    }
}
