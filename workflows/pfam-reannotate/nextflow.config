params {
    release        = 'https://ftp.ebi.ac.uk/pub/databases/metagenomics/peptide_database/current_release'
    hmm            = 'https://ftp.ebi.ac.uk/pub/databases/Pfam/releases/Pfam38.2/Pfam-A.hmm.gz'  // the release's own Pfam version
    targets        = 'reps'           // reps: 90% cluster representatives; all: every protein
    sample         = 1000             // 1 in this many targets, by protein_id
    reversed       = false            // also search every sequence reversed: the null arm (twice the work)
    pp             = false            // store each alignment's posterior probabilities (about twice the size)
    chunk_proteins = 500000           // proteins per hmmsearch job
    plan_args      = ''               // extra `reannotate.py plan` options
    // Fixed -Z and --domZ make E-values comparable across chunks: E = 10^6 x P, so -E 10 reports
    // sequences at P <= 1e-5, what hmmsearch's last filter (F3) lets through. --domE 1000000 keeps
    // every domain of them: some domains at GA have E above 10 (GA can be as low as 0 bits).
    hmmsearch_args = '-E 10 --domE 1000000 -Z 1000000 --domZ 1000000'
    outdir         = 'results'
    publish_mode   = 'copy'
    venv           = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    python         = "${params.venv}/bin/python"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'process_small' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_plan' {  // groups the release's ids
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_hmmsearch' {
        cpus   = 2     // more barely helps: 10 k proteins took 225, 180, 173 s at --cpu 1, 2, 4
        memory = { 4.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'COMPARE' {  // a 5-bit histogram over every hit file
        memory = { 16.GB * task.attempt }
    }
    withName: 'FASTA' {  // thousands of tasks reading shared files: a brief storage error should not stop the run
        errorStrategy = 'retry'
        maxRetries    = 3
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    raw       = true   // ms and bytes
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    test {
        params.release        = "${projectDir}/../../tests/data/mini_reannotate"
        params.hmm            = "${projectDir}/../../tests/data/mini_fmh/Pfam-mini.hmm"
        params.sample         = 1
        params.chunk_proteins = 20
        params.plan_args      = '--bin-width 10'
        params.outdir         = 'results-test'
        trace.file            = 'results-test/trace.tsv'
        process {
            withLabel: 'process_small|process_plan|process_hmmsearch' { cpus = 1; memory = 1.GB; time = 10.m }
        }
    }
}
