// Promiscuity cut (plan, phase 7, step 40): does dropping k-mers held by more than max_groups
// units (default 64) shrink the largest component the EM fits, and at what accuracy cost?
// Step 39 found the zero-inflated fit at 9,059 s on the one component above MAX_FIT_PAIRS
// (tbase10_all, 100 M pairs, fitted block-wise). As tiers.config (same 1-in-100 subset, one
// DIAMOND truth, aai under step34q), the large tier and tbase10_all at stricter cuts:
//   tbase05_all       the large release tier, max_groups 64 (the control);
//   tbase05_all_g16   ... 16, _g8 8, _g4 4; _g128 at 128, laxer than the default, to see
//                     whether keeping more shared (conserved) k-mers helps aai sensitivity;
//   tbase10_all       the one index that went block-wise at 100 M pairs; _g8 at 8.
// n_groups is counted over the subset's units, so 64 here is ~100x laxer than 64 in a full
// build: these cuts span part of the way to the release's (step 40).
// Indexes are published under mgnify_index/<name>/index for promiscuity-query-cost.
//   fmh promiscuity --aai_subset <dir>
params {
    aai_subset     = ''
    mgnify_indexes = [
        ['tbase05_all',     '--t-base 0.05 --n-min 32 --oversample 1'],
        ['tbase05_all_g128', '--t-base 0.05 --n-min 32 --oversample 1 --max-groups 128'],
        ['tbase05_all_g16', '--t-base 0.05 --n-min 32 --oversample 1 --max-groups 16'],
        ['tbase05_all_g8',  '--t-base 0.05 --n-min 32 --oversample 1 --max-groups 8'],
        ['tbase05_all_g4',  '--t-base 0.05 --n-min 32 --oversample 1 --max-groups 4'],
        ['tbase10_all',     '--t-base 0.1 --n-min 32 --oversample 1'],
        ['tbase10_all_g8',  '--t-base 0.1 --n-min 32 --oversample 1 --max-groups 8'],
    ].collect { name, args ->
        [name: name, members: "${params.aai_subset}/members.parquet",
         pfam: "${params.aai_subset}/pfam.parquet", args: '--k 11 ' + args]
    }
    indexes        = []
    labels         = 'pfam'
    min_hits       = '1,2,3'
    query_arms     = [[name: '', args: '']]
    host_fractions = '0'
    tools          = ''
    aai_models     = [[name: 'step34q', path: "${projectDir}/ablations/aai_models/step34q.json"]]
}

process {
    withName: 'MGNIFY_ANNOTATE|MGNIFY_NEAREST_ANNOTATE' { cpus = 16; memory = 64.GB; time = 24.h }
    withName: 'MGNIFY_DB|MGNIFY_MEMBER_DB' { cpus = 8; memory = 32.GB; time = 12.h }
}
