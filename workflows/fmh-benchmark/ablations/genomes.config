// Genome mode (plan, phase 11; README, Genome mode): every KEGG genome of the record (each
// sample's 64 plus the rest as distractors) annotated with a KO index and a 1-in-100 MGnify90
// index; genomes fitted per sample and scored against the read-origin truth
// (genome_scores.tsv), beside sylph on the same genomes. Gate: F1 and L1 within 0.05 of
// sylph's; the function x genome table's ft_l1 and ft_f1 no worse than HUMAnN 3.9's
// stratified output (not scored yet: needs KEGG genomes mapped to HUMAnN's species).
//   sbatch workflows/fmh-benchmark/run_ablations.sh genomes <outdir> --aai_subset <dir>
// --mgnify_full <dir>: a built full MGnify index, profiled and annotated too.
params {
    aai_subset     = ''
    mgnify_full    = ''
    mgnify_indexes = [
        [name: 'sparse', members: "${params.aai_subset}/members.parquet",
         pfam: "${params.aai_subset}/pfam.parquet", args: '--k 11 --t-base 0.001 --n-min 8'],
    ] + (params.mgnify_full ? [[name: 'full', path: params.mgnify_full]] : [])
    indexes        = [[name: 'kfp_s1000_floor8', args: '--k 11 --t-base 0.001 --n-min 8']]
    labels         = 'ko'
    genome_mode    = true
    query_arms     = [[name: '', args: '']]
    host_fractions = '0'
    tools          = ''
}

process {
    withName: 'ANNOTATE_GENOMES' { cpus = 8; memory = 64.GB; time = 24.h }
    withName: 'MGNIFY_ANNOTATE' { cpus = 16; memory = 64.GB; time = 24.h }
    withName: 'MGNIFY_DB' { cpus = 8; memory = 32.GB; time = 12.h }
}
