// max_groups 16 on the slim and standard tiers (plan, phase 7, step 43): step 42 measured the
// cut only on tbase05_all (recall -0.003 to -0.004); the default is now 16 for every tier. As
// promiscuity.config (same 1-in-100 subset, one DIAMOND truth, aai under step34q):
//   slim, tbase02_all16          max_groups 64 (pinned: the old default, the controls);
//   slim_g16, tbase02_all16_g16  max_groups 16 (the new default);
//   tbase05_all_g16              built as promiscuity-novaseq's, queried with the zero-inflated
//                                fit's new 10,000-step cap: against step 42's (1,000), the cap's
//                                effect on abundance and aai (same samples and index).
// Read summary.tsv and aai_summary.tsv against each control, paired by sample, as step 42.
//   fmh g16 --aai_subset <dir>
params {
    aai_subset     = ''
    mgnify_indexes = [
        ['slim',              '--t-base 0.01 --t-base-singleton 0.001 --n-min 8 --max-groups 64'],
        ['slim_g16',          '--t-base 0.01 --t-base-singleton 0.001 --n-min 8 --max-groups 16'],
        ['tbase02_all16',     '--t-base 0.02 --n-min 16 --oversample 1 --max-groups 64'],
        ['tbase02_all16_g16', '--t-base 0.02 --n-min 16 --oversample 1 --max-groups 16'],
        ['tbase05_all_g16',   '--t-base 0.05 --n-min 32 --oversample 1 --max-groups 16'],
    ].collect { name, args ->
        [name: name, members: "${params.aai_subset}/members.parquet",
         pfam: "${params.aai_subset}/pfam.parquet", args: '--k 11 ' + args]
    }
    indexes        = []
    labels         = 'pfam'
    min_hits       = '1,2,3'
    query_arms     = [[name: '', args: '']]
    host_fractions = '0'
    tools          = ''
    aai_models     = [[name: 'step34q', path: "${projectDir}/ablations/aai_models/step34q.json"]]
}

process {
    withName: 'MGNIFY_ANNOTATE|MGNIFY_NEAREST_ANNOTATE' { cpus = 16; memory = 64.GB; time = 24.h }
    withName: 'MGNIFY_DB|MGNIFY_MEMBER_DB' { cpus = 8; memory = 32.GB; time = 12.h }
}
