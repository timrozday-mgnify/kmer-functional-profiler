// Abundance under divergence (plan, phase 7, step 35): a finished run's MGnify90 indexes,
// queried again with the shipped coverage_zi and its interval (coverage_zi_lo/_hi,
// coverage_zi_dispersion), scored by aai-score's abund_* metrics against true depth, with aai
// under the release survival model (step34q). Nothing is rebuilt: the indexes are taken from
// --prebuilt (<outdir>/mgnify_index/<name>/index) for --prebuilt_names; the subset's members
// still give the MGnify90-level truth. Run once per read model and depth, each its own outdir:
//   fmh abundance --aai_subset <dir> --prebuilt ../floor-novaseq/results \
//       --prebuilt_names tbase05,tbase02_all,dense02 [--n_reads 1650000]
params {
    aai_subset     = ''
    prebuilt       = ''
    prebuilt_names = 'tbase05,tbase02_all'
    mgnify_indexes = params.prebuilt_names.toString().tokenize(',')*.trim().collect { name ->
        [name: name, path: "${params.prebuilt}/mgnify_index/${name}/index",
         members: "${params.aai_subset}/members.parquet", pfam: "${params.aai_subset}/pfam.parquet"]
    }
    indexes        = []
    labels         = 'pfam'
    min_hits       = '1,2,3'
    query_arms     = [[name: '', args: '']]
    host_fractions = '0'
    tools          = ''
    aai_models     = ['step34q'].collect { m ->
        [name: m, path: "${projectDir}/ablations/aai_models/${m}.json"]
    }
}

process {
    withName: 'MGNIFY_ANNOTATE|MGNIFY_NEAREST_ANNOTATE' { cpus = 16; memory = 64.GB; time = 24.h }
    withName: 'MGNIFY_DB|MGNIFY_MEMBER_DB' { cpus = 8; memory = 32.GB; time = 12.h }
}
