// Phase-7 host spike-in ladder: simulated T2T-CHM13 (+ rCRS chrM, PhiX) reads at 0, 50, 90 and
// 99% of read pairs, at constant depth (microbial pairs subsampled), against the base index:
// no handling; hostile (bowtie2, human-t2t-hla) upstream; the mask sidecar; the human-proteome
// decoy queried jointly; mask + decoy. Decides whether the release ships the human mask.
//   sbatch workflows/fmh-benchmark/run_ablations.sh host <outdir>
params {
    indexes = [
        [name: 'base', args: '--k 11 --t-base 0.001 --n-min 8'],
    ]
    query_arms = [
        [name: '',           args: ''],
        [name: 'hostile',    args: '', reads: 'hostile'],
        [name: 'mask',       args: '', mask: true],
        [name: 'decoy',      args: '', decoy: true],
        [name: 'mask_decoy', args: '', mask: true, decoy: true],
    ]
    host_fractions = '0,0.5,0.9,0.99'
    tools          = ''
}

process {
    withName: 'HOST_READS' { cpus = 16; memory = 64.GB; time = 24.h }  // iss over a 3.1 Gbp genome
    withName: 'MASK' { cpus = 2; memory = 32.GB; time = 4.h }         // six-frame scan of the genome
    withName: 'HOSTILE' { cpus = 8; memory = 16.GB; time = 8.h }
}
