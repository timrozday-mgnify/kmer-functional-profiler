// Study ladder (plan, phase 10, step 3; README, Study ladder): half of each sample's genomes
// as a study index queried jointly with a 1-in-100 MGnify90 index (arm study), against a
// rebuild of that index including those proteins (arm rebuild); study_ladder.tsv has the
// share of the rebuild's completeness gain the joint query recovers (gate >= 0.9), and
// study_unrelated.tsv whether base units the study does not touch changed (gate: none).
//   sbatch workflows/fmh-benchmark/run_ablations.sh study <outdir> --aai_subset <dir>
// One base, the phase-6 default; add entries (e.g. step 19's winner) to repeat it. Each
// entry costs one rebuild of the subset per seed.
params {
    aai_subset     = ''
    mgnify_indexes = [
        [name: 'sparse', members: "${params.aai_subset}/members.parquet",
         pfam: "${params.aai_subset}/pfam.parquet", args: '--k 11 --t-base 0.001 --n-min 8'],
    ]
    study_ladder   = true
    study_fraction = 0.5
    indexes        = []
    labels         = 'pfam'
    query_arms     = [[name: '', args: '']]
    host_fractions = '0'
    tools          = ''
}

process {
    withName: 'MGNIFY_ANNOTATE' { cpus = 16; memory = 64.GB; time = 24.h }
    withName: 'MGNIFY_DB' { cpus = 8; memory = 32.GB; time = 12.h }
}
