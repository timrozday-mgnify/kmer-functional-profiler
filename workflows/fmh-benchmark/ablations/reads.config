// Phase-7 read-side ablations on the base index: frame mode (stop-free, stop-free + edges at
// m = 15/20/30, all six) and read QC (raw, quality mask at q = 10/20/30, fastp then raw), and
// the mask crossed with edges, since both recover reads the stop filter drops. Run once per
// read model (binned NovaSeq qualities; MiSeq's poor tails):
//   sbatch workflows/fmh-benchmark/run_ablations.sh reads <outdir>/novaseq
//   sbatch workflows/fmh-benchmark/run_ablations.sh reads <outdir>/miseq --iss_model miseq
params {
    indexes = [
        [name: 'base',     args: '--k 11 --t-base 0.001 --n-min 8'],
        [name: 'tbase100', args: '--k 11 --t-base 0.01 --n-min 8'],
    ]
    query_arms = [
        [name: '',              args: ''],
        [name: 'edges15',       args: '--frames edges:15'],
        [name: 'edges20',       args: '--frames edges:20'],
        [name: 'edges30',       args: '--frames edges:30'],
        [name: 'all',           args: '--frames all'],
        [name: 'q10',           args: '--min-qual 10'],
        [name: 'q20',           args: '--min-qual 20'],
        [name: 'q30',           args: '--min-qual 30'],
        [name: 'fastp',         args: '', reads: 'fastp'],
        [name: 'q20_edges20',   args: '--min-qual 20 --frames edges:20'],
        [name: 'fastp_edges20', args: '--frames edges:20', reads: 'fastp'],
    ]
    host_fractions = '0'
    tools          = ''
}
