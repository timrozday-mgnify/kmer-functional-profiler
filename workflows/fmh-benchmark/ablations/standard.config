// Standard release tier at ~120 GB compact (plan, phase 7, step 28), as tiers.config
// (NovaSeq, plain frames, one 1-in-100 subset and DIAMOND truth, aai-score, AAI_CALIBRATE, Pfam):
//   sparse          the control for detection and Pfam;
//   tbase02_all     the ~140 GB standard that calibrates (step 27), the control for aai;
//   tbase02_n16     the best 16 of ~32 candidates (~120 GB; did not calibrate in step 27);
//   tbase015_all    tbase02_all's t_g with every candidate, the base stratum at 0.015 (~120 GB);
//   tbase02_all16   t_base 0.02 and every candidate up to half tbase02_all's t_g (~120 GB).
// The selection-conditioned aai (plan, phase 7, steps 24-25, on dev-aai) is applied offline with
// dev-aai's aai-score --model on these profiles. Indexes are published under
// mgnify_index/<name>/index for the query cost run. Run as
//   sbatch workflows/fmh-benchmark/run_ablations.sh standard <outdir> --aai_subset <dir>
params {
    aai_subset     = ''
    mgnify_indexes = [
        ['sparse',        '--t-base 0.001 --n-min 8'],
        ['tbase02_all',   '--t-base 0.02 --n-min 32 --oversample 1'],
        ['tbase02_n16',   '--t-base 0.02 --n-min 16 --oversample 2'],
        ['tbase015_all',  '--t-base 0.015 --n-min 32 --oversample 1'],
        ['tbase02_all16', '--t-base 0.02 --n-min 16 --oversample 1'],
    ].collect { name, args ->
        [name: name, members: "${params.aai_subset}/members.parquet",
         pfam: "${params.aai_subset}/pfam.parquet", args: '--k 11 ' + args]
    }
    indexes        = []
    labels         = 'pfam'
    min_hits       = '1,2,3,4'
    query_arms     = [[name: '', args: '']]
    host_fractions = '0'
    tools          = ''
}

process {
    withName: 'MGNIFY_ANNOTATE' { cpus = 16; memory = 64.GB; time = 24.h }
    withName: 'MGNIFY_DB' { cpus = 8; memory = 32.GB; time = 12.h }
}
