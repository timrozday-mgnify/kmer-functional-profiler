// Raised density floor against the dense tier at the MGnify90 level (plan, phase 7, step 19).
// One nested subset (1 in 100) built six ways, scored against one MGnify90-level truth (one
// shared DIAMOND annotation) by aai-score (aai_summary.tsv), AAI_CALIBRATE (calibration/) and
// on Pfam (summary.tsv):
//   sparse       the phase-6 default (k 11, t_base 0.001, n_min 8), the control;
//   dense02      + t_dense 0.02, step 15's candidate if granular aai ships;
//   tbase01/02/05  a raised floor: t_base is a density floor (every unit keeps all its k-mers
//                with hash <= t_base, the base stratum), plus the n_min best up to t_g;
//   tbase02_all  t_base 0.02 and every candidate up to the current t_g (oversample 1, n_min 32
//                gives the same t_g as n_min 8 at oversample 4): dense02's k-mers, in tier 2.
// tbase02_all against dense02 tests where the k-mers sit (pass 1, detection included, against
// pass 2 for detected units only); tbase02 against tbase02_all tests whether the plain floor
// is enough. Every index is published under mgnify_index/<name>/index for the query cost run
// (mgnify-subset --query). Run once per read model and depth, each its own outdir:
//   sbatch workflows/fmh-benchmark/run_ablations.sh floor <outdir>/novaseq --aai_subset <dir>
//   ... --iss_model miseq | --iss_mode perfect | --n_reads 1650000 | --n_reads 26400000
// <dir> holds members.parquet and pfam.parquet of the subset (mgnify-subset --sample 100,...
// publishes the densest sample's at the top of its outdir; step 15 used cost-nested).
params {
    aai_subset     = ''
    mgnify_indexes = [
        ['sparse',      '--t-base 0.001 --n-min 8'],
        ['dense02',     '--t-base 0.001 --n-min 8 --t-dense 0.02'],
        ['tbase01',     '--t-base 0.01 --n-min 8'],
        ['tbase02',     '--t-base 0.02 --n-min 8'],
        ['tbase05',     '--t-base 0.05 --n-min 8'],
        ['tbase02_all', '--t-base 0.02 --n-min 32 --oversample 1'],
    ].collect { name, args ->
        [name: name, members: "${params.aai_subset}/members.parquet",
         pfam: "${params.aai_subset}/pfam.parquet", args: '--k 11 ' + args]
    }
    indexes    = []          // KO/Pfam-unit indexes: the index run
    labels     = 'pfam'
    query_arms = [
        [name: '',        args: ''],
        [name: 'edges20', args: '--frames edges:20'],
    ]
    host_fractions = '0'
    tools          = ''
}

process {
    withName: 'MGNIFY_ANNOTATE' { cpus = 16; memory = 64.GB; time = 24.h }
    withName: 'MGNIFY_DB' { cpus = 8; memory = 32.GB; time = 12.h }
}
