// Frame mode at the MGnify90 level on the release tiers (plan, phase 7, step 28): stop-free
// (whole frames without a stop; the default until step 31, now edges:30), stop-free + edges (also the terminal segments
// of frames with stops, >= m aa) and all (every stop-free segment). Decides the default by
// the rule of project-wide 2026-10-01: edges or all only if they cut the short-protein
// abundance error (aai-score's abund_err_len*, completeness_90_len*) without losing purity,
// at an acceptable hashing cost (the frames-query-cost run). Indexes: slim and tbase05_all
// (the chosen slim and large tiers) and tbase02_all (standing in for the standard tier).
// Once per read model, each its own outdir:
//   sbatch workflows/fmh-benchmark/run_ablations.sh frames <outdir>/novaseq --aai_subset <dir>
//   ... --iss_model miseq
params {
    aai_subset     = ''
    mgnify_indexes = [
        ['slim',        '--t-base 0.01 --t-base-singleton 0.001 --n-min 8'],
        ['tbase02_all', '--t-base 0.02 --n-min 32 --oversample 1'],
        ['tbase05_all', '--t-base 0.05 --n-min 32 --oversample 1'],
    ].collect { name, args ->
        [name: name, members: "${params.aai_subset}/members.parquet",
         pfam: "${params.aai_subset}/pfam.parquet", args: '--k 11 ' + args]
    }
    indexes    = []
    labels     = 'pfam'
    min_hits   = '1,2,3,4'   // edges and all hit more units: compare at matched purity
    query_arms = [
        [name: '',        args: '--frames stopfree'],  // the default before step 31
        [name: 'edges20', args: '--frames edges:20'],
        [name: 'edges30', args: '--frames edges:30'],
        [name: 'all',     args: '--frames all'],
    ]
    host_fractions = '0'
    tools          = ''
}

process {
    withName: 'MGNIFY_ANNOTATE|MGNIFY_NEAREST_ANNOTATE' { cpus = 16; memory = 64.GB; time = 24.h }
    withName: 'MGNIFY_DB|MGNIFY_MEMBER_DB' { cpus = 8; memory = 32.GB; time = 12.h }
}
