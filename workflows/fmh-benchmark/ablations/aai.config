// Run (phase 7, step 15); superseded by floor.config (step 19), which keeps sparse and
// t_dense 0.02 as controls. Kept as the record of the step 15 ladder.
// Unit-level resolution and containment AAI at the MGnify90 level, sparse against dense: the
// benchmark genomes' proteins searched against the representatives of a MGnify90 subset's
// clusters (DIAMOND), and indexes built here from that subset scored by aai-score
// (aai_summary.tsv, one row per index and arm) and on Pfam (summary.tsv). Detection
// (completeness_90, purity, recall_<lo>) and aai_naive use tier 2 only, so they match across
// the ladder; the dense tier changes aai and its interval (aai_bias_<lo>, aai_cover_<lo>,
// aai_spearman) and Pfam abundance. Entries sharing members share one DIAMOND annotation.
// Use a nested all-biome subset (mgnify-subset --sample 100,...: MERGE publishes the densest
// sample's members.parquet and pfam.parquet at the top of its outdir): annotating
// against the whole release's ~1.7e9 representatives costs ~1e3-1e4 CPU-h.
// Fill in the paths, then:
//   sbatch workflows/fmh-benchmark/run_ablations.sh aai <outdir>
params {
    mgnify_indexes = [
        ['mgnify_1in100',     ''],
        ['mgnify_1in100_d02', ' --t-dense 0.02'],
        ['mgnify_1in100_d05', ' --t-dense 0.05'],
        ['mgnify_1in100_d10', ' --t-dense 0.1'],
    ].collect { name, dense ->
        def subset = '<shared>/cost-nested'  // members.parquet and pfam.parquet at 1 in 100
        [name: name, members: "${subset}/members.parquet", pfam: "${subset}/pfam.parquet",
         args: '--k 11 --t-base 0.001 --n-min 8' + dense]
    }
    indexes    = []          // KO/Pfam-unit indexes are not needed for this run
    labels     = 'pfam'
    query_arms = [
        [name: '',        args: ''],
        [name: 'edges20', args: '--frames edges:20'],
    ]
    host_fractions = '0'
    tools          = ''
}

process {
    withName: 'MGNIFY_ANNOTATE|MGNIFY_NEAREST_ANNOTATE' { cpus = 16; memory = 64.GB; time = 24.h }
    withName: 'MGNIFY_DB|MGNIFY_MEMBER_DB' { cpus = 8; memory = 32.GB; time = 12.h }
}
