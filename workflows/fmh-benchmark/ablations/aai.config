// Unit-level resolution and containment AAI at the MGnify90 level: the benchmark genomes'
// proteins searched against the representatives of a MGnify90 index's clusters (DIAMOND), and
// that index's unit profiles scored by aai-score (aai_summary.tsv). Use a nested all-biome
// subset (mgnify-subset, --sample 100 or 1000) whose members table is at hand: annotating
// against the whole release's ~1.7e9 representatives is possible but costs ~1e3-1e4 CPU-h.
// Fill in the paths, then:
//   sbatch workflows/fmh-benchmark/run_ablations.sh aai <outdir>
params {
    mgnify_indexes = [
        // a built index and the members it was built from (representatives for the truth)
        [name: 'mgnify_1in100', path: '<shared>/cost-nested/1in100/index',
         members: '<shared>/cost-nested/members.1in100.parquet'],
        // or build it here, with a dense tier for aai (sparse indexes lose AAI below 90%):
        // [name: 'mgnify_1in100_d10', members: '<...>/members.1in100.parquet',
        //  pfam: '<...>/pfam.1in100.parquet', args: '--k 11 --t-base 0.001 --n-min 8 --t-dense 0.1'],
    ]
    indexes    = []          // KO/Pfam-unit indexes are not needed for this run
    labels     = 'pfam'
    query_arms = [
        [name: '',        args: ''],
        [name: 'edges20', args: '--frames edges:20'],
    ]
    host_fractions = '0'
    tools          = ''
}

process {
    withName: 'MGNIFY_ANNOTATE' { cpus = 16; memory = 64.GB; time = 24.h }
    withName: 'MGNIFY_DB' { cpus = 8; memory = 32.GB; time = 12.h }
}
