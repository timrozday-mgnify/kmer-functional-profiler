// Unknown fraction of a metagenome (plan, phase 7, steps 14 and 36): the hold-out ladder on the
// fmh benchmark. The slim and standard release tiers are built on the 1-in-100 subset as is and
// without the units that 10, 30 and 50% of the sampled genomes (those the 10 samples drew, step
// 40; the whole pool before) hit at >= 70% identity (nested: the 10% are among the 30%); every
// profile runs with --summary, and unknown-score compares census_containment with the share of
// read bases from genes that keep a unit at >= 90 / 80 / 70% or any identity
// (unknown_summary.tsv). The rule (step 14, B only since step 40): census monotone in the
// hold-out (Spearman >= 0.9). explained_fraction was dropped (step 39: it over-counts).
//   fmh unknown --aai_subset <dir>
params {
    aai_subset     = ''
    mgnify_indexes = [
        ['slim',          '--t-base 0.01 --t-base-singleton 0.001 --n-min 8'],
        ['tbase02_all16', '--t-base 0.02 --n-min 16 --oversample 1'],
    ].collect { name, args ->
        [name: name, members: "${params.aai_subset}/members.parquet",
         pfam: "${params.aai_subset}/pfam.parquet", args: '--k 11 ' + args]
    }
    holdout        = '0,0.1,0.3,0.5'
    indexes        = []
    labels         = 'pfam'
    min_hits       = '1,2,3'
    query_arms     = [[name: '', args: '']]
    host_fractions = '0'
    tools          = ''
    aai_models     = []
}

process {
    withName: 'MGNIFY_ANNOTATE|MGNIFY_NEAREST_ANNOTATE' { cpus = 16; memory = 64.GB; time = 24.h }
    withName: 'MGNIFY_DB|MGNIFY_MEMBER_DB' { cpus = 8; memory = 32.GB; time = 12.h }
}
