// Phase-7 index ablations: one factor at a time around the phase-6 defaults (k 11, 20
// letters, t_base 1/1000, n_min 8, t_cap 0.2, no dense tier). Every config is built per
// label (KO units, and Pfam units as pfam_<name>); --all-estimators scores EM against gather,
// winner-take-all, uniqueness-first, zero inflation and p_in weighting in the same profiles.
// Raised floor against dense tier (plan, phase 7, step 19): t_base is a density floor (every
// unit keeps all its k-mers with hash <= t_base), so tbase02 holds in tier 2 what dense02
// holds in the dense tier; for KO/Pfam units t_g ~ t_base, so the pair isolates where the
// k-mers sit (pass 1, detection included, against pass 2 for detected units only).
// tbase02_all keeps every candidate up to the current t_g (oversample 1, n_min 32: the same
// t_g as n_min 8 at oversample 4) instead of the 8 best: dense02's set exactly, in tier 2.
//   sbatch workflows/fmh-benchmark/run_ablations.sh index <outdir>
params {
    indexes = [
        [name: 'base',        args: '--k 11 --t-base 0.001 --n-min 8'],
        // count floor
        [name: 'nmin0',       args: '--k 11 --t-base 0.001 --n-min 0'],
        [name: 'nmin4',       args: '--k 11 --t-base 0.001 --n-min 4'],
        [name: 'nmin16',      args: '--k 11 --t-base 0.001 --n-min 16'],
        // density floor (raised t_base)
        [name: 'tbase01',     args: '--k 11 --t-base 0.01 --n-min 8'],
        [name: 'tbase02',     args: '--k 11 --t-base 0.02 --n-min 8'],
        [name: 'tbase05',     args: '--k 11 --t-base 0.05 --n-min 8'],
        [name: 'tbase02_all', args: '--k 11 --t-base 0.02 --n-min 32 --oversample 1'],
        // dense tier
        [name: 'dense02',     args: '--k 11 --t-base 0.001 --n-min 8 --t-dense 0.02'],
        [name: 'dense05',     args: '--k 11 --t-base 0.001 --n-min 8 --t-dense 0.05'],
        [name: 'dense10',     args: '--k 11 --t-base 0.001 --n-min 8 --t-dense 0.1'],
        // cap on t_g (and so on the query's sampling rate)
        [name: 'tcap05',      args: '--k 11 --t-base 0.001 --n-min 8 --t-cap 0.05'],
        [name: 'tcap10',      args: '--k 11 --t-base 0.001 --n-min 8 --t-cap 0.1'],
        // k (20 letters: k <= 12)
        [name: 'k9',          args: '--k 9 --t-base 0.001 --n-min 8'],
        [name: 'k10',         args: '--k 10 --t-base 0.001 --n-min 8'],
        [name: 'k12',         args: '--k 12 --t-base 0.001 --n-min 8'],
        // reduced alphabets, at k giving about the same k-mer space (Index encoding)
        [name: 'murphy10_k13', args: '--k 13 --alphabet murphy10 --t-base 0.001 --n-min 8'],
        [name: 'murphy10_k15', args: '--k 15 --alphabet murphy10 --t-base 0.001 --n-min 8'],
        [name: 'dayhoff_k17',  args: '--k 17 --alphabet dayhoff --t-base 0.001 --n-min 8'],
        [name: 'dayhoff_k20',  args: '--k 20 --alphabet dayhoff --t-base 0.001 --n-min 8'],
    ]
    query_arms     = [[name: '', args: '']]
    host_fractions = '0'
    tools          = ''
}
