// Release tiers (plan, phase 7, step 21): slim / standard / large candidates at the MGnify90 level,
// as floor.config (same 1-in-100 subset, one DIAMOND truth, aai-score, AAI_CALIBRATE, Pfam):
//   sparse       the phase-6 default, the control;
//   tbase01      measured in step 20, the control for slim;
//   slim         t_base 0.01 for clusters with >= 2 members, 0.001 for singletons (~50 GB at
//                full scale in the compact format, against tbase01's ~80 GB);
//   tbase02_all  standard, step 20's only arm passing the aai rule (~140 GB compact);
//   tbase02_n16  a smaller standard (~120 GB): the same t_g, the best 16 of ~32 candidates
//                (tbase02, the best 8, is ~100 GB but its aai does not calibrate);
//   tbase05_all  large: the 0.05 floor with every candidate up to t_g;
//   tbase10_all  whether filling ~500 GB buys anything over tbase05_all.
// Indexes are published under mgnify_index/<name>/index for the query cost run. Run as
//   sbatch workflows/fmh-benchmark/run_ablations.sh tiers <outdir> --aai_subset <dir>
params {
    aai_subset     = ''
    mgnify_indexes = [
        ['sparse',      '--t-base 0.001 --n-min 8'],
        ['tbase01',     '--t-base 0.01 --n-min 8'],
        ['slim',        '--t-base 0.01 --t-base-singleton 0.001 --n-min 8'],
        ['tbase02_all', '--t-base 0.02 --n-min 32 --oversample 1'],
        ['tbase02_n16', '--t-base 0.02 --n-min 16 --oversample 2'],
        ['tbase05_all', '--t-base 0.05 --n-min 32 --oversample 1'],
        ['tbase10_all', '--t-base 0.1 --n-min 32 --oversample 1'],
    ].collect { name, args ->
        [name: name, members: "${params.aai_subset}/members.parquet",
         pfam: "${params.aai_subset}/pfam.parquet", args: '--k 11 ' + args]
    }
    indexes        = []
    labels         = 'pfam'
    min_hits       = '1,2,3'
    query_arms     = [[name: '', args: '']]
    host_fractions = '0'
    tools          = ''
}

process {
    withName: 'MGNIFY_ANNOTATE' { cpus = 16; memory = 64.GB; time = 24.h }
    withName: 'MGNIFY_DB' { cpus = 8; memory = 32.GB; time = 12.h }
}
