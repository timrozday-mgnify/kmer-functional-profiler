// Example site config for the fmh benchmark on a Slurm cluster with Singularity/Apptainer.
// Copy it, fill in the <...> values and pass it with -c (see run_hpc.sh):
//   nextflow run workflows/fmh-benchmark -profile slurm,singularity -c hpc.config -resume

params {
    data_dir           = '<shared storage>/fmh-benchmark-data'  // Zenodo inputs + tool databases (~140 GB)
    outdir             = '<shared storage>/fmh-benchmark-results/tools-v1'
    // built by containers/build.sh --sif (or docker://<registry>/<image> after --push)
    kmermaid_container = '<shared storage>/containers/kfp-kmermaid.sif'
    humann3_container  = '<shared storage>/containers/kfp-humann3.sif'
    humann4_container  = '<shared storage>/containers/kfp-humann4.sif'
    // tools = 'diamond,fmh_funprofiler,kmermaid,humann,humann4'  // default: all five
}

singularity {
    // images are pulled and converted once; containers/pull.sh fills it from a login node
    cacheDir = '<shared storage>/singularity-cache'
    // runOptions = '-B <extra path>'  // if data or work dirs are outside the auto-mounted paths
}

process {
    // queue = '<partition>'
    // clusterOptions = '--account=<account>'

    // Compute nodes without internet: download on the head node's host instead.
    // withName: 'FETCH|HUMANN_DB|METAPHLAN_DB' { executor = 'local' }

    // Resource overrides by label or name, e.g. more threads for DIAMOND and HUMAnN:
    // withName: 'DIAMOND' { cpus = 16; memory = 64.GB }
    // withLabel: 'process_humann' { cpus = 32; memory = 128.GB }
}

executor {
    queueSize = 50  // concurrent Slurm jobs
}
