params {
    data_dir   = 'fmh-benchmark-data'   // Zenodo 10055954 inputs, downloaded once (storeDir)
    db_dir     = params.data_dir        // other tools' databases, built once (storeDir)
    sketches   = 'KOs_sketched_scaled_1000.sig.zip'
    ksize      = 11
    n_genomes  = 64                     // genomes per metagenome, as in the paper
    replicates = 10                     // metagenomes, seeds 1..replicates
    n_reads    = 6600000                // InSilicoSeq reads (both mates), ~1 Gbp at 151 bp
    iss_model  = 'novaseq'              // hiseq, novaseq or miseq
    iss_mode   = 'kde'                  // 'perfect': error-free reads (iss_model unused)
    draws      = 100                    // posterior draws for abundance intervals and ambiguity groups
    min_hits   = '1,2'                  // distinct k-mers for a KO to count as detected; each is scored
    diamond_min_hits = '1,2,3,5,10,20,50,100'  // read pairs, for DIAMOND's purity/completeness curve
    indexes    = [
        [name: 'kfp_s1000',        args: '--k 11 --t-base 0.001 --n-min 0'],
        [name: 'kfp_s1000_floor8', args: '--k 11 --t-base 0.001 --n-min 8'],
        [name: 'kfp_s100',         args: '--k 11 --t-base 0.01 --n-min 0'],
        [name: 'kfp_s100_d10',     args: '--k 11 --t-base 0.01 --n-min 0 --t-dense 0.1'],
    ]
    // other tools, each profiled and scored like an index (see README): comma-separated subset
    // of diamond, fmh_funprofiler, kmermaid, humann (3.9), humann4; '' for none
    tools                = 'diamond,fmh_funprofiler,kmermaid,humann,humann4'
    sketch_scaled        = 1000     // scaled of --sketches (fmh_funprofiler)
    diamond_args         = ''       // extra diamond blastx options, e.g. '--sensitive'
    kmermaid_max_members = 50       // proteins sampled per KO to train kMermaid
    // images built by containers/build.sh: docker tags here; .sif paths or docker:// URIs on HPC
    kmermaid_container   = 'kfp-kmermaid:edcb4ed'
    humann3_container    = 'kfp-humann3:3.9-bt2.5.5'
    humann4_container    = 'kfp-humann4:e07b3a3'
    metaphlan_index      = 'mpa_vJun23_CHOCOPhlAnSGB_202403'  // HUMAnN 3.9 (MetaPhlAn 4.1.1)
    humann4_metaphlan_index = 'mpa_vOct22_CHOCOPhlAnSGB_202403'  // the database HUMAnN 4 alpha.2 requires
    outdir     = 'results'
    venv       = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    python     = "${params.venv}/bin/python"
    kfp        = "${params.venv}/bin/kmer-functional-profiler"
    bench      = "${params.python} ${projectDir}/bench.py"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'process_single' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_high_memory' {
        cpus   = 1
        memory = { 128.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withLabel: 'process_kmermaid' {  // single-threaded; holds the retrained model in memory
        cpus   = 1
        memory = { 32.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withLabel: 'process_humann' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
}

// Tool processes (DIAMOND, fmh-funprofiler, kMermaid, HUMAnN) run in containers: combine
// -profile docker (local) or singularity (HPC) with the others. Every other process runs on
// the host, in the project's venv, which is on a path the containers never need.

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"   // per-task runtime and memory (PROFILE = query cost)
    raw       = true   // ms and bytes, for bench.py cost
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    docker {
        docker.enabled    = true
        // biocontainers are amd64 only; Apple silicon runs them under emulation
        docker.runOptions = '--platform linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        // docker:// images are converted once and kept here (or set NXF_SINGULARITY_CACHEDIR)
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/singularity"
    }
    test {
        params.data_dir   = "${projectDir}/../../tests/data/mini_fmh"
        params.sketches   = 'KOs_mini.sig'
        params.n_genomes  = 2
        params.replicates = 2
        params.n_reads    = 2000
        params.indexes    = [
            [name: 'kfp_s10',        args: '--k 11 --t-base 0.1 --n-min 0'],
            [name: 'kfp_s10_floor8', args: '--k 11 --t-base 0.1 --n-min 8'],
            [name: 'kfp_s10_d100',   args: '--k 11 --t-base 0.1 --n-min 0 --t-dense 1.0'],
        ]
        params.outdir     = 'results-test'
        params.db_dir     = 'results-test/db'
        trace.file        = 'results-test/trace.tsv'
        params.tools      = 'diamond,fmh_funprofiler,kmermaid'  // HUMAnN's databases are ~45 GB
        params.sketch_scaled = 10
        process {
            withLabel: 'process_single' { memory = 1.GB; time = 10.m }
            withLabel: 'process_medium' { cpus = 2; memory = 2.GB; time = 10.m }
            withLabel: 'process_high_memory' { memory = 2.GB; time = 10.m }
            withLabel: 'process_kmermaid' { memory = 2.GB; time = 10.m }
            withLabel: 'process_humann' { cpus = 2; memory = 4.GB; time = 30.m }
        }
    }
}
