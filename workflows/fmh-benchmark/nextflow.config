params {
    data_dir   = 'fmh-benchmark-data'   // Zenodo 10055954 inputs, downloaded once (storeDir)
    sketches   = 'KOs_sketched_scaled_1000.sig.zip'
    ksize      = 11
    n_genomes  = 64                     // genomes per metagenome, as in the paper
    replicates = 10                     // metagenomes, seeds 1..replicates
    n_reads    = 6600000                // InSilicoSeq reads (both mates), ~1 Gbp at 151 bp
    iss_model  = 'novaseq'              // hiseq, novaseq or miseq
    iss_mode   = 'kde'                  // 'perfect': error-free reads (iss_model unused)
    draws      = 100                    // posterior draws for abundance intervals and ambiguity groups
    min_hits   = '1,2'                  // distinct k-mers for a KO to count as detected; each is scored
    indexes    = [
        [name: 'kfp_s1000',        args: '--k 11 --t-base 0.001 --n-min 0'],
        [name: 'kfp_s1000_floor8', args: '--k 11 --t-base 0.001 --n-min 8'],
        [name: 'kfp_s100',         args: '--k 11 --t-base 0.01 --n-min 0'],
        [name: 'kfp_s100_d10',     args: '--k 11 --t-base 0.01 --n-min 0 --t-dense 0.1'],
    ]
    outdir     = 'results'
    venv       = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    python     = "${params.venv}/bin/python"
    kfp        = "${params.venv}/bin/kmer-functional-profiler"
    bench      = "${params.python} ${projectDir}/bench.py"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'process_single' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_high_memory' {
        cpus   = 1
        memory = { 128.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"   // per-task runtime and memory (PROFILE = query cost)
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    test {
        params.data_dir   = "${projectDir}/../../tests/data/mini_fmh"
        params.sketches   = 'KOs_mini.sig'
        params.n_genomes  = 2
        params.replicates = 2
        params.n_reads    = 2000
        params.indexes    = [
            [name: 'kfp_s10',        args: '--k 11 --t-base 0.1 --n-min 0'],
            [name: 'kfp_s10_floor8', args: '--k 11 --t-base 0.1 --n-min 8'],
            [name: 'kfp_s10_d100',   args: '--k 11 --t-base 0.1 --n-min 0 --t-dense 1.0'],
        ]
        params.outdir     = 'results-test'
        process {
            withLabel: 'process_single' { memory = 1.GB; time = 10.m }
            withLabel: 'process_medium' { cpus = 2; memory = 2.GB; time = 10.m }
            withLabel: 'process_high_memory' { memory = 2.GB; time = 10.m }
        }
    }
}
