params {
    release        = 'https://ftp.ebi.ac.uk/pub/databases/metagenomics/peptide_database/current_release'
    hmm            = ''               // the collection: one HMM file, plain or gzipped, local or remote
    cutoff         = 'gathering'      // gathering, trusted or noise: the HMM file's own thresholds
    thresholds     = ''               // or a TSV of model, threshold, full|domain (KOfam's ko_list)
    engine         = 'kfpfam'         // kfpfam: its prefilter, then HMMER; nail: its seeds, then HMMER; hmmsearch: HMMER on every model
    targets        = 'all'            // reps: 90% cluster representatives; all: every protein
    members        = false            // with targets reps: their members too, HMMER only, from the representatives' hits
    member_filter  = ''               // kfpfam or nail on the members as well, and HMMER on the models of either
    min_cluster    = 1                // with member_filter: the first search is of the clusters this size or more only, and
                                      // the prefilter has the rest
    member_slack   = 8                // bits under a model's thresholds a representative's hit may be, for its members
    sample         = 1000             // 1 in this many targets, by protein_id (clusters, with members)
    check_sample   = 0                // 1 in this many of those also through full hmmsearch; 0: none
    compare_release = false           // compare with the release's own Pfam table, made with Pfam 38.2
    domains        = true             // write the domain rows; labels are always written
    forward_slack  = 8                // a candidate this many bits under by HMMER's Forward filter gets no domain
                                      // definition; '' for none. Not for --engine hmmsearch, the truth, nor with --members
    weak_evalue    = 0                // domains under the thresholds too, at this E-value (Z = 10^6); 0: none
    chunk_proteins = 1000000          // proteins per SEARCH task, the same for every engine so that they share FASTAs
    member_batch   = 160000000        // protein_ids per MEMBER_PAIRS task: about 25 M representatives
    member_width   = 20000000         // protein_ids per MEMBER_SEARCH task: about 7 M members, 580 tasks
    plan_args      = ''               // extra `reannotate.py plan` options
    profile        = false            // a run of its own: each sampled protein's cost by hmmsearch and by kfpfam
                                      // (--kfpfam_mode), timed per protein (profile.py), and nothing else

    // kfpfam: its image (hmmsearch runs in it too) and settings
    kfpfam_sif        = ''
    kfpfam_filter     = 'filter'
    kfpfam_python     = 'python3'
    kfpfam_prep_py    = '/opt/kfpfam/prep.py'
    kfpfam_mode       = 'top'         // top: as near every domain as it goes; fast: 99.8% of them
    // theta: a seed threshold per model, P(a stretch that just passes has no seed) = exp(-theta).
    // min_gapped: one bar, lower for short repeats; with slack, bars that many bits under each model's
    // weakest passing domain (query length left out), and min_gapped their most. top is the raw-reads arm's,
    // a benchmark of the method on proteins: annotations are --engine hmmsearch's
    kfpfam_modes      = [
        top:  [theta: 9, bar: 15, gate: 14.5, min_gapped: 21.25, slack: 0],
        fast: [theta: 5, bar: 18, gate: 17.5, min_gapped: 45, slack: 10],
    ]
    kfpfam_seed       = '10110001'    // the residues a seed takes
    kfpfam_band       = 15            // 16, as for reads, has a loose SIMD bound on whole proteins
    kfpfam_diagonals  = 'any'         // the pairs of 'all', but a pair is done at the first diagonal that reaches its bar
    kfpfam_block      = 80000         // proteins at a time: about the residues of 400,000 reads' ORFs

    // nail: image and settings, as the raw-reads pipeline's and the B11 nail arm's
    nail_sif         = 'quay.io/biocontainers/nail:0.7.1--hab7d0fd_0'
    nail             = 'nail'         // mmseqs is found on the PATH
    nail_seed_pvalue = 0.01           // nail's own default is 1e-4
    nail_proteins    = 1250000        // proteins at a time, over a chunk's most (chunk_proteins and one planning bin)

    outdir         = 'results'
    publish_mode   = 'copy'
    venv           = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    python         = "${params.venv}/bin/python"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'kfpfam' {
        container = params.kfpfam_sif
    }
    withLabel: 'process_nail' {  // about 8 KB of temporary files a protein for 7,534 models, so 55 GB for 39.0's
        container = params.nail_sif
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withLabel: 'process_small' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_plan' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_prep' {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_search' {
        cpus   = 8
        memory = { 32.GB * task.attempt }  // 39.0's filter took 2 to 8 GB on reads' ORFs, its profiles about 3
        time   = { 24.h * task.attempt }
    }
    withName: 'PLAN|FASTA' {
        ext.args = "--min-cluster ${params.min_cluster}"
    }
    withName: 'FASTA' {  // thousands of tasks reading shared files: a brief storage error should not stop the run
        errorStrategy = 'retry'
        maxRetries    = 3
        cpus          = 4
        time          = 24.h  // a sample's chunk is spread over much of the release
    }
    withName: 'MEMBER_FASTA' {
        time = 24.h
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    raw       = true   // ms and bytes
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    test {
        params.release        = "${projectDir}/../../tests/data/mini_reannotate"
        params.hmm            = "${projectDir}/../../tests/data/mini_fmh/Pfam-mini.hmm"
        params.sample         = 1
        params.check_sample   = 1
        params.compare_release = true
        params.chunk_proteins = 20
        params.plan_args      = '--bin-width 10'
        params.outdir         = 'results-test'
        trace.file            = 'results-test/trace.tsv'
        process {
            withLabel: 'process_small|process_plan|process_prep|process_search|process_nail' { cpus = 1; memory = 2.GB; time = 10.m }
        }
    }
}
