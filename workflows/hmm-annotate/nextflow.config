params {
    release        = 'https://ftp.ebi.ac.uk/pub/databases/metagenomics/peptide_database/current_release'
    hmm            = ''               // the collection: one HMM file, plain or gzipped, local or remote
    cutoff         = 'gathering'      // gathering, trusted or noise: the HMM file's own thresholds
    thresholds     = ''               // or a TSV of model, threshold, full|domain (KOfam's ko_list)
    targets        = 'all'            // reps: 90% cluster representatives; all: every protein
    sample         = 1000             // 1 in this many targets, by protein_id
    check_sample   = 0                // 1 in this many of those also through full hmmsearch; 0: none
    compare_release = false           // compare with the release's own Pfam table, made with Pfam 38.2
    domains        = true             // write the domain rows; labels are always written
    weak_evalue    = 0                // domains under the thresholds too, at this E-value (Z = 10^6); 0: none
    chunk_proteins = 500000           // proteins per SEARCH task
    plan_args      = ''               // extra `reannotate.py plan` options

    // kfpfam: its image, and Mode A's settings (measured on reads' ORFs; --check_sample measures them here)
    kfpfam_sif        = ''
    kfpfam_filter     = 'filter'
    kfpfam_python     = 'python3'
    kfpfam_prep_py    = '/opt/kfpfam/prep.py'
    kfpfam_bits       = 6.5           // the index's k-mer threshold
    kfpfam_bar        = 17
    kfpfam_gate       = 16.5
    kfpfam_min_gapped = 21.25
    kfpfam_block      = 80000         // proteins at a time: about the residues of 400,000 reads' ORFs

    outdir         = 'results'
    publish_mode   = 'copy'
    venv           = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    python         = "${params.venv}/bin/python"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'kfpfam' {
        container = params.kfpfam_sif
    }
    withLabel: 'process_small' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_plan' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_prep' {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_search' {
        cpus   = 8
        memory = { 32.GB * task.attempt }  // 39.0's filter took 2 to 8 GB on reads' ORFs, its profiles about 3
        time   = { 24.h * task.attempt }
    }
    withName: 'FASTA' {  // thousands of tasks reading shared files: a brief storage error should not stop the run
        errorStrategy = 'retry'
        maxRetries    = 3
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    raw       = true   // ms and bytes
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    test {
        params.release        = "${projectDir}/../../tests/data/mini_reannotate"
        params.hmm            = "${projectDir}/../../tests/data/mini_fmh/Pfam-mini.hmm"
        params.sample         = 1
        params.check_sample   = 1
        params.compare_release = true
        params.chunk_proteins = 20
        params.plan_args      = '--bin-width 10'
        params.kfpfam_bits    = 7.5   // a smaller index
        params.outdir         = 'results-test'
        trace.file            = 'results-test/trace.tsv'
        process {
            withLabel: 'process_small|process_plan|process_prep|process_search' { cpus = 1; memory = 2.GB; time = 10.m }
        }
    }
}
