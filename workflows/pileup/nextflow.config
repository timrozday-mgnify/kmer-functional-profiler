params {
    samples      = ''      // CSV: sample, r1, r2 (paths relative to the CSV allowed)
    index        = ''      // a kfp index directory, or:
    targets      = ''      // a FASTA of targets to build one from (`index --targets`)
    index_args   = ''      // with --targets, e.g. '--alphabet dna' or '--groups g.tsv'
    store        = ''      // members tables to fetch sequences from (glob; default the
                           // index's own targets.parquet), e.g. the MERGE output
    query_args   = ''      // extra `kmer-functional-profiler query` options
    query_stats  = false   // publish query --stats as <sample>/stats.json (phase 13, step 0)
    max_fdr      = 0.05    // targets: the top units by present_prob at this false discovery rate
    max_targets  = 0       // at most this many targets, the most hit first (0 = no cap)
    aai          = false   // QUERY with --aai (aai/ani columns; not needed for targets)
    min_identity = 0       // QUERY --min-identity theta (implies --aai): relatives below theta not targets
    neighbours   = 5       // neighbour decoys per target in a component, the most-hit first
    members      = 3       // sequences per unit (representative + spread others)
    route        = true    // each pair to DIAMOND against the reference blocks its k-mers hit
                           // (kfp-pileup route); pairs with no hit dropped; amino acids only
    route_block_letters = 2000000  // residues per block of whole components
    route_k      = 8       // routing k-mer length (0: the index's k); smaller routes more distant relatives
    route_min_kmers = 3    // distinct k-mers a pair must share with a block to be sent there
    diamond_top  = 10      // keep hits within this % of each read's best bit score
    diamond_args = '--sensitive'
    diamond_fields = 'qseqid sseqid bitscore qstart qend sstart send qframe btop'  // must match
                                                       // kfp_pileup.pileup.DIAMOND_FIELDS
    bwa_args     = ''
    min_depth    = 3       // variants.tsv: least column depth (posterior weights)
    min_freq     = 0.2     // variants.tsv: least alt frequency
    novel        = 0.1     // steps 8-9: least divergence of a novel relative from the reference
    frameshift   = 15      // DIAMOND -F: frameshift penalty (0: off), step 6b; to tune on short reads
    min_assign   = 0.5     // hand-off BAM: least responsibility of a pair's unit (step 8)
    freebayes_args = ''    // step 6c: freebayes runs with --pooled-continuous
    lofreq       = false   // step 6c: LoFreq as a second caller (low frequencies)
    lofreq_args  = ''
    floria       = true    // step 6c: Floria strain haplotypes
    floria_args  = '--snp-count-filter 1'  // genes, not genomes: its default wants 100 SNPs
    cliquesnv    = true    // step 6c: CliqueSNV haplotypes (linked SNVs), per sequence
    cliquesnv_min_reads = 20  // sequences with fewer hand-off records are not phased
    cliquesnv_args = ''
    instrain     = true    // step 6c: inStrain profile, per-gene microdiversity
    instrain_args = ''
    outdir       = 'results'
    venv         = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    kfp          = "${params.venv}/bin/kmer-functional-profiler"
    kfp_pileup   = "${params.venv}/bin/kfp-pileup"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    time          = 4.h
    memory        = 2.GB
    withLabel: 'process_single' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
}

// DIAMOND and bwa-mem2 run in containers: combine -profile docker (local) or singularity
// (HPC) with the others. kfp and kfp-pileup run on the host, in the project's venv.

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"   // DIAMOND / bwa-mem2 time against QUERY's (step 3's rule)
    raw       = true
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    docker {
        docker.enabled    = true
        // biocontainers are amd64 only; Apple silicon runs them under emulation
        docker.runOptions = '--platform linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/singularity"
    }
    test {  // the fixture proteins and their reads (amino-acid index, DIAMOND)
        params.samples    = "${projectDir}/test/samples.csv"
        params.targets    = "${projectDir}/../../tests/data/proteins.faa"
        params.index_args = '--k 7 --t-base 1'
        params.min_depth  = 1
        params.outdir     = 'results-test'
        trace.file        = 'results-test/trace.tsv'
        process {
            withLabel: 'process_medium' { cpus = 2; memory = 2.GB; time = 20.m }
            withLabel: 'process_single' { memory = 2.GB; time = 20.m }
        }
    }
    test_nucleotide {  // the same reads against the fixture CDS (nucleotide index, bwa-mem2)
        params.samples    = "${projectDir}/test/samples.csv"
        params.targets    = "${projectDir}/../../tests/data/cds.fna"
        params.index_args = '--alphabet dna --t-base 1'
        params.min_depth  = 1
        params.outdir     = 'results-test-nucleotide'
        trace.file        = 'results-test-nucleotide/trace.tsv'
        process {
            withLabel: 'process_medium' { cpus = 2; memory = 2.GB; time = 20.m }
            withLabel: 'process_single' { memory = 2.GB; time = 20.m }
        }
    }
}
