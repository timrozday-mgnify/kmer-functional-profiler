// workflows/pileup's params, processes and profiles (docker, singularity, slurm), then this
// benchmark's own. Its test profiles below replace the pileup ones of the same name.
includeConfig '../pileup/nextflow.config'

params {
    molecule       = 'protein'  // or 'nucleotide' (adds --alphabet dna to index_args)
    targets        = ''         // a FASTA of targets (protein or nucleotide), or make them:
    groups         = ''         // optional TSV: target, unit (index --groups)
    seed_fasta     = ''         // seed proteins for spike.py families
    families       = 50
    families_args  = ''         // e.g. '--paralogs 3 --members 3 --paralog-identity 0.8 0.9'
    seeds          = 3          // samples, one per simulation seed
    siblings_args  = ''         // spike.py siblings options, e.g. '--siblings 0.1 --sibling-identity 0.8 0.9'
    simulate_args  = ''         // spike.py simulate options, e.g. '--present 0.3 --error 0.002'
    background     = ''         // 'r1.fq.gz,r2.fq.gz': real pairs the strains are spiked into
    background_pairs = 0        // pairs of the background used (0 = all)
    index_args     = ''         // kfp index options (with --targets and --groups)
    aa_arm         = true       // nucleotide: also kfp on the translated targets
    aa_index_args  = ''
    kma            = true       // nucleotide: also KMA
    kma_args       = ''
    aai_model      = ''         // aai_model.json attached to an amino-acid index, e.g.
                                // workflows/fmh-benchmark/ablations/aai_models/step34q.json
    query_args     = ''         // `--aai` is always on (pileup's QUERY)
    outdir         = 'results'
}

process {
    withLabel: 'process_low' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
}

trace.file = "${params.outdir}/trace.tsv"

profiles {
    // Laptop-sized (a few minutes with Docker): 100 MGnify sample families (3 units of 3
    // members each), 3 samples, the standard tier's sampling (tbase02_all16).
    local {
        params.seed_fasta    = "${projectDir}/../../data/mgnify/mgy_clusters_head.faa"
        params.families      = 100
        params.index_args    = '--t-base 0.02 --n-min 16 --oversample 1'
        params.outdir        = 'results-local'
        trace.file           = 'results-local/trace.tsv'
        process {
            withLabel: 'process_medium' { cpus = 4; memory = 8.GB }
        }
    }
    local_nucleotide {
        params.molecule      = 'nucleotide'
        params.seed_fasta    = "${projectDir}/../../data/mgnify/mgy_clusters_head.faa"
        params.families      = 100
        params.index_args    = '--t-base 0.02 --n-min 16 --oversample 1'
        params.aa_index_args = '--t-base 0.02 --n-min 16 --oversample 1'
        params.outdir        = 'results-local-nucleotide'
        trace.file           = 'results-local-nucleotide/trace.tsv'
        process {
            withLabel: 'process_medium' { cpus = 4; memory = 8.GB }
        }
    }
    test {  // 10 families from the fixture proteins, 2 samples, amino-acid index (DIAMOND)
        params.seed_fasta    = "${projectDir}/../../tests/data/proteins.faa"
        params.families      = 10
        params.seeds         = 2
        params.index_args    = '--k 7 --t-base 0.2 --n-min 0'
        params.simulate_args = '--depth-mu 2'
        params.siblings_args = '--siblings 0.2'
        params.min_depth     = 1
        params.outdir        = 'results-test'
        trace.file           = 'results-test/trace.tsv'
        process {
            withLabel: 'process_low' { cpus = 1; memory = 2.GB; time = 20.m }
            withLabel: 'process_medium' { cpus = 2; memory = 4.GB; time = 30.m }
        }
    }
    test_nucleotide {  // the same, nucleotide index (bwa-mem2), with KMA and the amino-acid arm
        params.molecule      = 'nucleotide'
        params.seed_fasta    = "${projectDir}/../../tests/data/proteins.faa"
        params.families      = 10
        params.seeds         = 2
        params.index_args    = '--k 21 --t-base 0.2 --n-min 0'
        params.aa_index_args = '--k 7 --t-base 0.2 --n-min 0'
        params.simulate_args = '--depth-mu 2'
        params.siblings_args = '--siblings 0.2'
        params.min_depth     = 1
        params.outdir        = 'results-test-nucleotide'
        trace.file           = 'results-test-nucleotide/trace.tsv'
        process {
            withLabel: 'process_low' { cpus = 1; memory = 2.GB; time = 20.m }
            withLabel: 'process_medium' { cpus = 2; memory = 4.GB; time = 30.m }
        }
    }
}
