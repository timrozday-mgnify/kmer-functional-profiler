params {
    members       = ''        // reference members parquet (protein_id, cluster_rep, full_length, sequence), absolute
    per_bin       = 250       // held-out relatives per identity bin (recall.py holdout)
    pool          = 15000     // proteins searched for relatives
    strains       = 500       // simulated strains per depth
    part_proteins = 250000    // build part size
    outdir        = 'results'
    data          = ''        // the scripts' shared data directory; '' = <outdir>/data
    venv          = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    python        = "${params.venv}/bin/python"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 64.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    // tier 2 holds the confirmed units' leaves and their seed index per chunk
    withLabel: 'process_high' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    raw       = true
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem'
}

profiles {
    slurm { process.executor = 'slurm' }
    laptop {  // the mini-slice check, one step at a time
        executor.queueSize = 1
        process {
            withLabel: 'process_medium' { cpus = 2; memory = 5.GB; time = 2.h }
            withLabel: 'process_high' { cpus = 2; memory = 5.GB; time = 2.h }
        }
    }
}
