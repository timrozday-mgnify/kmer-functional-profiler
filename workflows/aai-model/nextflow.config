params {
    members      = ''        // members table (protein_id, cluster_rep, full_length, sequence), e.g.
                             // mgnify-proteins-subset/results/lin100-dense/members.parquet
    n_queries    = 200000    // members drawn as P (standard residues only); each aligns to its
                             // own and nearby clusters
    chunks       = 20        // DIAMOND jobs
    per_bin      = 5000      // pairs kept per bin of 0.02 of nearest-member identity over 0.6-1.0
    per_bin_candidates = 15000  // candidates kept per bin of identity to the representative:
                             // nearest-member identity runs higher, so oversample
    min_cov      = 0.8       // query and subject coverage of a pair's best HSP
    k            = 11
    alphabet     = 'protein'
    seed         = 1
    diamond_args = '--more-sensitive --max-target-seqs 50 --id 55 --query-cover 80 --subject-cover 80'
    // pass 2, against the candidates' members: a P in a large cluster can fill its targets with
    // that cluster's members and lose another candidate's (PAIRS logs how many candidates kept
    // a member hit); raise if many are lost
    diamond_nearest_args = '--more-sensitive --max-target-seqs 1000 --id 55 --query-cover 80 --subject-cover 80'
    outdir       = 'results'
    venv         = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    fit_model    = "${params.venv}/bin/python ${projectDir}/fit_model.py"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    time          = 4.h
    memory        = 2.GB
    withLabel: 'process_medium' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_high_memory' {
        cpus   = 8
        memory = { 128.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
}

profiles {
    slurm { process.executor = 'slurm' }
    docker { docker.enabled = true }
    test {  // stub runs and small local checks
        process {
            withLabel: 'process_medium|process_high_memory' { cpus = 1; memory = 1.GB; time = 10.m }
        }
    }
}
