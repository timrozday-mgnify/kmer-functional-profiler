params {
    catalogue_url     = 'https://ftp.ebi.ac.uk/pub/databases/metagenomics/mgnify_genomes/human-gut/v2.0.2'
    data_dir          = 'species-benchmark-data'  // the catalogue's metadata, downloaded once (storeDir)
    // the index profiled against: a built one, or members (+ pfam) to build it here
    index             = ''
    members           = ''
    pfam              = ''
    index_args        = '--k 11 --t-base 0.001 --n-min 8'
    query_args        = ''
    // samples (bench.py uhgg-pick)
    replicates        = 5
    per_sample        = 30          // species per sample, one held-out genome each
    min_genomes       = 20          // species with fewer genomes are not sampled
    min_completeness  = 90          // held-out genomes: CheckM completeness and contamination
    max_contamination = 5
    distractors       = 300         // species in the index beyond the samples'
    depth_min         = 0.05        // per-genome depth, log-uniform
    depth_max         = 10
    seed              = 1
    iss_model         = 'novaseq'
    iss_mode          = 'kde'       // 'perfect': error-free reads
    // species index variants and the arms fitted on them (plan, phase 11, step 10)
    species_indexes   = [
        [name: 'default',  args: ''],
        [name: 'noshrink', args: '--alpha 1e-9'],
        [name: 'nocompl',  args: '--no-completeness'],
    ]
    species_arms      = [
        [arm: 'species',          index: 'default',  args: ''],
        [arm: 'species_nobg',     index: 'default',  args: '--background-prior 0'],
        [arm: 'species_noshrink', index: 'noshrink', args: ''],
        [arm: 'species_nocompl',  index: 'nocompl',  args: ''],
    ]
    fit_args          = ''          // every species arm, e.g. '--min-units 5'
    genome_args       = ''          // genome mode (G1) on the representatives
    sylph_c           = 200
    sylph_container   = 'quay.io/biocontainers/sylph:1.0.0--hb42e459_0'
    outdir            = 'results'
    venv              = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    python            = "${params.venv}/bin/python"
    kfp               = "${params.venv}/bin/kmer-functional-profiler"
    kfp_prior         = "${params.venv}/bin/kfp-prior"
    bench             = "${params.python} ${projectDir}/../fmh-benchmark/bench.py"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'process_single' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_high_memory' {
        cpus   = 1
        memory = { 64.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    raw       = true
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    docker {  // sylph only; everything else runs in the project's venv
        docker.enabled    = true
        docker.runOptions = '--platform linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/singularity"
    }
    test {  // tests/data/mini_uhgg: the mini_fmh genomes as a three-species catalogue
        params.catalogue_url = "file://${projectDir}/../../tests/data/mini_uhgg"
        params.members       = "${projectDir}/../../tests/data/mini_fmh/mgnify_members.parquet"
        params.pfam          = "${projectDir}/../../tests/data/mini_fmh/mgnify_pfam.parquet"
        params.index_args    = '--k 11 --t-base 0.5 --n-min 0'
        params.replicates    = 2
        params.per_sample    = 2
        params.min_genomes   = 3
        params.distractors   = 1
        params.depth_min     = 2
        params.depth_max     = 8
        params.fit_args      = '--min-units 2'
        params.genome_args   = '--min-units 2'
        params.data_dir      = 'results-test-species/data'
        params.outdir        = 'results-test-species'
        trace.file           = 'results-test-species/trace.tsv'
        process {
            withLabel: 'process_single' { memory = 1.GB; time = 10.m }
            withLabel: 'process_medium' { cpus = 2; memory = 2.GB; time = 10.m }
            withLabel: 'process_high_memory' { memory = 2.GB; time = 10.m }
        }
    }
}
