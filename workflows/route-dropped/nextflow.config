params {
    ref      = ''         // the unrouted baseline's <sample>/ref (workflows/pileup REFERENCE)
    profile  = ''         // its <sample>/profile.tsv
    index    = ''         // the kfp index (absolute path: read in place)
    store    = ''         // members tables (an absolute glob), default the index's targets.parquet
    withhold = ''         // units left out of the reference (a spike's withhold.txt, absolute)
    r1       = ''
    r2       = ''
    reads    = 2000000    // dropped reads aligned, single-end (a seeded subsample; 0 = all)
    outdir   = 'results'
    venv     = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    python   = "${params.venv}/bin/python"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    // DROPPED: the sample's reads and per-read hits; FULLREF: every profile unit's sequences
    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 128.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    // DIAMOND --sensitive against ~1-3 B residues
    withLabel: 'process_high' {
        cpus   = 32
        memory = { 128.GB * task.attempt }
        time   = { 72.h * task.attempt }
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"   // DIAMOND's CPU-h per arm (dropped.py summarise)
    raw       = true
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem'
}

profiles {
    slurm { process.executor = 'slurm' }
    docker {
        docker.enabled    = true
        // biocontainers are amd64 only; Apple silicon runs them under emulation
        docker.runOptions = '--platform linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/singularity"
    }
    local {  // laptop check on small inputs (with docker)
        process {
            withLabel: 'process_medium' { cpus = 2; memory = 4.GB; time = 1.h }
            withLabel: 'process_high' { cpus = 2; memory = 6.GB; time = 1.h }
        }
    }
}
