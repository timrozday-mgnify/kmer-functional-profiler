params {
    release        = 'https://ftp.ebi.ac.uk/pub/databases/metagenomics/peptide_database/current_release'
    pfam           = ''               // hmm-annotate's output directory for Pfam, --targets all
    hmm            = ''               // the Pfam-A.hmm[.gz] it was made with
    labels         = ''               // ko=DIR,ec=DIR: hmm-annotate outputs whose models are labels
    groups         = 400              // BUILD tasks, about
    batch_chunks   = 50               // annotation chunks per SPLIT task
    shard_width    = 50000000         // protein_ids per membership file
    pfam_version   = '38.2'           // recorded in the bundle
    mgnify_version = '2026_07'
    check_parquet  = ''               // a sample's *_pfam_alignments.parquet to profile with the bundle

    lookup_sif     = ''               // workflows/pfam-anchor/lookup/Dockerfile's image
    lookup_python  = 'python3'

    outdir         = 'results'
    publish_mode   = 'copy'
    venv           = "${projectDir}/../../.venv"  // created by workflows/setup.sh
    python         = "${params.venv}/bin/python"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'lookup' {
        container = params.lookup_sif
    }
    withLabel: 'process_host' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_split' {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_build' {  // a family is held whole: PF00005 sets the ceiling
        cpus   = 4
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_assemble' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    raw       = true   // ms and bytes
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    test {  // needs the lookup binary: cargo build --release in workflows/pfam-anchor/lookup/rs
        params.release        = "${projectDir}/../../tests/data/mini_reannotate"
        params.pfam           = "${projectDir}/../../tests/data/mini_annotation/pfam"
        params.labels         = "ko=${projectDir}/../../tests/data/mini_annotation/kofam"
        params.hmm            = "${projectDir}/../../tests/data/mini_fmh/Pfam-mini.hmm"
        params.check_parquet  = "${projectDir}/../../tests/data/mini_annotation/reads.parquet"
        params.groups         = 3
        params.batch_chunks   = 2
        params.shard_width    = 25
        params.lookup_python  = "${projectDir}/../../.venv/bin/python"
        params.outdir         = 'results-test'
        trace.file            = 'results-test/trace.tsv'
        env.LOOKUP_BIN        = "${projectDir}/../pfam-anchor/lookup/rs/target/release/lookup"
        process {
            withLabel: 'process_host|process_split|process_build|process_assemble' { cpus = 1; memory = 2.GB; time = 10.m }
        }
    }
}
