params {
    ref     = ''          // the unrouted baseline's <sample>/ref (workflows/pileup REFERENCE)
    profile = ''          // its <sample>/profile.tsv
    index   = ''          // the kfp index (absolute path)
    store   = ''          // members tables (glob, quoted), default the index's targets.parquet
    withhold = ''         // units left out of the reference (a spike's withhold.txt, absolute)
    r1      = ''
    r2      = ''
    reads   = 2000000     // dropped reads aligned, single-end (a seeded subsample; 0 = all)
    outdir  = 'results'
    python  = ""          // the repo venv's python (absolute path; run.sh sets it)
}

process {
    withLabel: 'python'  { cpus = 4;  memory = { 128.GB * task.attempt }; time = { 24.h * task.attempt } }
    withLabel: 'diamond' { cpus = 32; memory = { 128.GB * task.attempt }; time = { 72.h * task.attempt } }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    raw       = true
    fields    = 'task_id,hash,native_id,name,status,exit,cpus,realtime,%cpu,peak_rss,peak_vmem'
}

profiles {
    local {  // laptop check on small inputs, DIAMOND under Docker
        docker.enabled    = true
        docker.runOptions = '--platform linux/amd64'
        process {
            withLabel: 'python'  { cpus = 2; memory = 4.GB }
            withLabel: 'diamond' { cpus = 2; memory = 6.GB }
        }
    }
}
