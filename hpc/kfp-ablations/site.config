// Site config shared by every run in kfp-ablations/ (from the EBI Slurm custom.config).
// Relative paths resolve against the launch directory, i.e. a run directory
// <runs>/kfp-ablations/<run>/, so '..' is kfp-ablations/ and '../..' is <runs>.
params {
    max_memory = '512.GB'
    data_dir   = '../fmh-benchmark-data'  // shared storeDir: Zenodo inputs + databases, filled by 00-dbs
    db_dir     = '../fmh-benchmark-data'
    tools      = ''                       // the ablations run no other tools
}

executor {
    name              = 'slurm'
    queueSize         = 75
    queueGlobalStatus = true
    submitRateLimit   = '10 sec'
    pollInterval      = '10 sec'
}

process.cache = 'lenient'

singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = '../../singularity_cache'
    pullTimeout = '60 min'
    registry    = 'quay.io'
    ociAutoPull = false
}

process.errorStrategy = {
    if (task.attempt == 1) return 'retry'
    if (task.previousException?.toString()?.contains('terminated for an unknown reason')) return 'retry'  // NODE_FAIL
    if (task.exitStatus in ((130..145) + 104)) return 'retry'
    return 'finish'
}

conda.enabled = false
cleanup = false
nextflow.enable.moduleBinaries = true
